          "msg": "Stream<MealPlanDataModel>",
          "return": true
        },
        {
          "from": "MealPlanRepositoryImpl",
          "to": "MealPlanBloc",
          "msg": "Right(MealPlanEntity)",
          "return": true
        },
        {
          "from": "MealPlanBloc",
          "to": "MealPlanPage",
          "msg": "MealPlanLoaded",
          "return": true
        }
      ]
    },
