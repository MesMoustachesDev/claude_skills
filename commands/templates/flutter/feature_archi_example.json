          "msg": "call(week)"
        },
        {
          "from": "WatchMealPlanUseCase",
          "to": "MealPlanBloc",
          "msg": "Left(NetworkError)",
          "return": true
        },
        {
          "from": "MealPlanBloc",
          "to": "MealPlanPage",
          "msg": "MealPlanError + retry",
          "return": true
        },
        {
          "from": "user",
